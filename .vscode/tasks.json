{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "E:/MinGw/ucrt64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++20",
                "-Wall",
                "-Wextra",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}",
                "env": {
                    "TMPDIR": "E:/Temp",
                    // g++ needs the DLLs in its own folder; without this it dies silently
                    "PATH": "E:/MinGw/ucrt64/bin;${env:PATH}"
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Single file. This is what the debugger (F5) builds."
        },
        {
            "label": "Build & Run active file",
            "type": "process",
            "command": "${fileDirname}/${fileBasenameNoExtension}.exe",
            "dependsOn": "C/C++: g++.exe build active file",
            "dependsOrder": "sequence",
            "options": {
                "env": {
                    // the built .exe needs libstdc++ from here too
                    "PATH": "E:/MinGw/ucrt64/bin;${env:PATH}"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true,
                "clear": true
            },
            "problemMatcher": [],
            "detail": "Compiles the current file then runs it in the terminal."
        },
        {
            "label": "Build & Run whole folder",
            "type": "shell",
            "command": "$env:TMPDIR='E:/Temp'; g++ -std=c++20 -Wall -Wextra -g *.cpp -o Program.exe; if ($?) { & './Program.exe' }",
            "options": {
                "cwd": "${fileDirname}",
                "env": {
                    "PATH": "E:/MinGw/ucrt64/bin;${env:PATH}"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true,
                "clear": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Compiles EVERY .cpp next to the active file into Program.exe, then runs it. Use this one for TaskManager."
        },
        {
            "label": "Build & Run TaskManager1.0",
            "type": "shell",
            // Every .cpp in the project (subfolders too), headers from Headers/, SQLite linked at the end
            "command": "$env:TMPDIR='E:/Temp'; $Files = (Get-ChildItem -Recurse -Filter *.cpp).FullName; g++ -std=c++20 -Wall -Wextra -g -IHeaders $Files -o TaskManager.exe -lsqlite3; if ($?) { & './TaskManager.exe' }",
            "options": {
                "cwd": "${workspaceFolder}/TaskManager1.0",
                "env": {
                    "PATH": "E:/MinGw/ucrt64/bin;${env:PATH}"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true,
                "clear": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Builds all of TaskManager1.0 (any folder, any .cpp) with Headers/ and SQLite, then runs it. Works from whatever file is open."
        }
    ]
}
