{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build OpenGL",
            "type": "shell",
            "command": "g++",
            "args": [
                "OpenGLStuff/OpenGL.cpp",
                "OpenGLStuff/glad.c",
                "-o",
                "OpenGLStuff/OpenGL.exe",
                "-IE:\\C++ Projects\\OpenGLStuff\\External",
                "-IE:\\OpenGL\\glfw-3.4.bin.WIN64\\include",
                "-IE:\\OpenGL\\glad\\include",
                "-LE:\\OpenGL\\glfw-3.4.bin.WIN64\\lib-mingw-w64",
                "-lglfw3",
                "-lopengl32",
                "-lgdi32"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "E:\\MinGw\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Task generated by Debugger."
        }
    ]
}